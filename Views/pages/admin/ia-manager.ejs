<!doctype html>
<html lang="pt-br">

<%- include('../head.ejs', { pageTitle: pageTitle || 'Gerenciar IA' }) %>

<body>
  <div class="page-wrapper" id="main-wrapper" data-layout="vertical" data-navbarbg="skin6" data-sidebartype="full"
    data-sidebar-position="fixed" data-header-position="fixed">
    <aside class="left-sidebar">
      <div>
        <div class="brand-logo d-flex align-items-center justify-content-between">
          <a href="/dashboard" class="text-nowrap logo-img">
            <img src="<%= logo ? logo : 'https://upload.wikimedia.org/wikipedia/commons/f/f7/WhatsApp_logo.svg' %>" alt="logo" class="img-fluid" />
          </a>
          <div class="close-btn d-xl-none d-block sidebartoggler cursor-pointer" id="sidebarCollapse">
            <i class="ti ti-x fs-8"></i>
          </div>
        </div>
        <%- include('../sidebar.ejs', { token }) %>
      </div>
    </aside>

    <div class="body-wrapper">
      <%- include('../header.ejs') %>

      <div class="container-fluid">
        
        <!-- Estatísticas em Cards -->
        <div class="row mb-4">
          <div class="col-lg-3 col-md-6">
            <div class="card bg-primary-subtle border-0">
              <div class="card-body">
                <div class="d-flex align-items-center">
                  <div class="flex-grow-1">
                    <h2 class="mb-0"><%= totalSessoes %></h2>
                    <p class="mb-0 text-muted">Total de Sessões</p>
                  </div>
                  <div class="text-primary">
                    <i class="ti ti-users fs-8"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-md-6">
            <div class="card bg-success-subtle border-0">
              <div class="card-body">
                <div class="d-flex align-items-center">
                  <div class="flex-grow-1">
                    <h2 class="mb-0"><%= sessoesAtivas %></h2>
                    <p class="mb-0 text-muted">IA Ativa</p>
                  </div>
                  <div class="text-success">
                    <i class="ti ti-robot fs-8"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-md-6">
            <div class="card bg-warning-subtle border-0">
              <div class="card-body">
                <div class="d-flex align-items-center">
                  <div class="flex-grow-1">
                    <h2 class="mb-0"><%= totalSessoes - sessoesAtivas %></h2>
                    <p class="mb-0 text-muted">IA Desativada</p>
                  </div>
                  <div class="text-warning">
                    <i class="ti ti-robot-off fs-8"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-lg-3 col-md-6">
            <div class="card bg-info-subtle border-0">
              <div class="card-body">
                <div class="d-flex align-items-center">
                  <div class="flex-grow-1">
                    <h2 class="mb-0">GPT-4o</h2>
                    <p class="mb-0 text-muted">Modelo Ativo</p>
                  </div>
                  <div class="text-info">
                    <i class="ti ti-brain fs-8"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tabela Principal -->
        <div class="row">
          <div class="col-12">
            <div class="card">
              <div class="card-body">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                  <div>
                    <h5 class="card-title fw-semibold">🤖 Gerenciar IA por Sessão</h5>
                    <p class="mb-0 text-muted">Ative ou desative a inteligência artificial para cada sessão individual.</p>
                  </div>
                  <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" onclick="abrirModalNovaSession()">
                      <i class="ti ti-plus"></i> Nova Sessão
                    </button>
                    <button class="btn btn-outline-primary btn-sm" onclick="atualizarStatus()">
                      <i class="ti ti-refresh"></i> Atualizar
                    </button>
                  </div>
                </div>
                
                <div class="table-responsive">
                  <table class="table table-hover align-middle" id="iaManagerTable">
                    <thead class="table-light">
                      <tr>
                        <th class="fw-semibold">Sessão</th>
                        <th class="fw-semibold">Empresa</th>
                        <th class="fw-semibold">Status IA</th>
                        <th class="fw-semibold">Configuração</th>
                        <th class="fw-semibold text-center">Ações</th>
                      </tr>
                    </thead>
                    <tbody id="tabela-sessoes">
                      <% if (sessoes && sessoes.length > 0) { %>
                        <% sessoes.forEach(sessao => { %>
                          <tr id="sessao-<%= sessao.id %>">
                            <td>
                              <div>
                                <h6 class="mb-1"><%= sessao.session %></h6>
                                <small class="text-muted"><%= sessao.sessionkey || 'N/A' %></small>
                              </div>
                            </td>
                            <td>
                              <%= sessao.empresa_nome || 'Empresa não definida' %>
                            </td>
                            <td>
                              <% if (sessao.ia_ativa) { %>
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                  <i class="ti ti-robot me-1"></i>Ativa
                                </span>
                              <% } else { %>
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                  <i class="ti ti-robot-off me-1"></i>Inativa
                                </span>
                              <% } %>
                            </td>
                            <td>
                              <div class="d-flex flex-column gap-1">
                                <% if (sessao.idprompt) { %>
                                  <span class="badge bg-info-subtle text-info border border-info-subtle">
                                    <i class="ti ti-message-circle me-1"></i>Prompt OK
                                  </span>
                                  <% if (sessao.vector_name) { %>
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                      <i class="ti ti-brain me-1"></i>RAG Ativo
                                    </span>
                                  <% } %>
                                <% } else { %>
                                  <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                    <i class="ti ti-x me-1"></i>Não configurado
                                  </span>
                                <% } %>
                              </div>
                            </td>
                            <td class="text-center">
                              <div class="btn-group" role="group">
                                <button 
                                  class="btn <%= sessao.ia_ativa ? 'btn-outline-danger' : 'btn-outline-success' %> btn-sm"
                                  data-id="<%= sessao.id %>" 
                                  data-session="<%= sessao.session %>"
                                  onclick="toggleIA(this.dataset.id, this.dataset.session)"
                                  id="btn-<%= sessao.id %>">
                                  <i class="ti ti-<%= sessao.ia_ativa ? 'player-pause' : 'player-play' %>"></i>
                                </button>
                                <button 
                                  class="btn btn-outline-primary btn-sm"
                                  data-id="<%= sessao.id %>"
                                  onclick="editarSession(this.dataset.id)"
                                  title="Editar">
                                  <i class="ti ti-edit"></i>
                                </button>
                                <button 
                                  class="btn btn-outline-danger btn-sm"
                                  data-id="<%= sessao.id %>" 
                                  data-session="<%= sessao.session %>"
                                  onclick="confirmarExclusao(this.dataset.id, this.dataset.session)"
                                  title="Excluir">
                                  <i class="ti ti-trash"></i>
                                </button>
                              </div>
                            </td>
                          </tr>
                        <% }); %>
                      <% } else { %>
                        <tr>
                          <td colspan="5" class="text-center text-muted">
                            <i class="ti ti-info-circle"></i> Nenhuma sessão encontrada
                          </td>
                        </tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>

                <% if (typeof erro !== 'undefined' && erro) { %>
                  <div class="alert alert-danger">
                    <i class="ti ti-alert-circle"></i> <%= erro %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <!-- Informações -->
        <div class="row">
          <div class="col-12">
            <div class="card bg-primary-subtle border-0">
              <div class="card-body">
                <h6 class="card-title text-primary mb-3">
                  <i class="ti ti-info-circle me-2"></i>Como funciona o sistema de IA
                </h6>
                <div class="row">
                  <div class="col-md-6">
                    <ul class="list-unstyled mb-0">
                      <li class="mb-2"><i class="ti ti-check text-success me-2"></i><strong>IA Ativa:</strong> Responde automaticamente usando o prompt configurado</li>
                      <li class="mb-2"><i class="ti ti-x text-danger me-2"></i><strong>IA Inativa:</strong> Envia apenas mensagem padrão (se configurada)</li>
                    </ul>
                  </div>
                  <div class="col-md-6">
                    <ul class="list-unstyled mb-0">
                      <li class="mb-2"><i class="ti ti-message-circle text-info me-2"></i><strong>Prompt:</strong> Configure na plataforma OpenAI</li>
                      <li class="mb-2"><i class="ti ti-brain text-warning me-2"></i><strong>RAG:</strong> IA consulta documentos específicos</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Modal Nova Sessão -->
  <div class="modal fade" id="modalNovaSession" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">
            <i class="ti ti-plus me-2"></i>Nova Sessão
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="formNovaSession">
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="form-label">Sessão *</label>
                  <input type="text" class="form-control" name="session" required>
                  <div class="form-text">Nome único da sessão (ex: empresa1)</div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="form-label">Session Key *</label>
                  <input type="text" class="form-control" name="sessionkey" required>
                  <div class="form-text">Chave única da sessão</div>
                </div>
              </div>
            </div>
            
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="form-label">Nome da Empresa</label>
                  <input type="text" class="form-control" name="empresa_nome" placeholder="Minha Empresa">
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="form-label">URL API</label>
                  <input type="url" class="form-control" name="api_url" placeholder="https://api.exemplo.com">
                </div>
              </div>
            </div>
            
            <div class="mb-3">
              <label class="form-label">Mensagem Padrão</label>
              <textarea class="form-control" name="mensagem_padrao" rows="3" placeholder="Olá! Como posso ajudar você?"></textarea>
            </div>
            
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="form-label">ID do Prompt</label>
                  <input type="text" class="form-control" name="idprompt" placeholder="ID do prompt OpenAI">
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="form-label">Nome do Vector</label>
                  <input type="text" class="form-control" name="vector_name" placeholder="Nome do vector para RAG">
                </div>
              </div>
            </div>
            
            <div class="mb-3">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="ia_ativa" id="ia_ativa_nova">
                <label class="form-check-label" for="ia_ativa_nova">
                  Ativar IA imediatamente
                </label>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-primary" onclick="salvarNovaSession()" id="btnSalvarNova">
            <i class="ti ti-device-floppy me-1"></i>Salvar Sessão
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Editar Sessão -->
  <div class="modal fade" id="modalEditarSession" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">
            <i class="ti ti-edit me-2"></i>Editar Sessão
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="formEditarSession">
            <input type="hidden" name="id" id="edit_id">
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="form-label">Sessão</label>
                  <input type="text" class="form-control" name="session" id="edit_session" readonly>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="form-label">Session Key</label>
                  <input type="text" class="form-control" name="sessionkey" id="edit_sessionkey">
                </div>
              </div>
            </div>
            
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="form-label">Nome da Empresa</label>
                  <input type="text" class="form-control" name="empresa_nome" id="edit_empresa_nome">
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="form-label">URL API</label>
                  <input type="url" class="form-control" name="api_url" id="edit_api_url">
                </div>
              </div>
            </div>
            
            <div class="mb-3">
              <label class="form-label">Mensagem Padrão</label>
              <textarea class="form-control" name="mensagem_padrao" id="edit_mensagem_padrao" rows="3"></textarea>
            </div>
            
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="form-label">ID do Prompt</label>
                  <input type="text" class="form-control" name="idprompt" id="edit_idprompt">
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="form-label">Nome do Vector</label>
                  <input type="text" class="form-control" name="vector_name" id="edit_vector_name">
                </div>
              </div>
            </div>
            
            <div class="mb-3">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="ia_ativa" id="edit_ia_ativa">
                <label class="form-check-label" for="edit_ia_ativa">
                  IA Ativa
                </label>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-primary" onclick="salvarEdicaoSession()" id="btnSalvarEdicao">
            <i class="ti ti-device-floppy me-1"></i>Salvar Alterações
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Confirmar Exclusão -->
  <div class="modal fade" id="modalConfirmarExclusao" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title text-danger">
            <i class="ti ti-alert-triangle me-2"></i>Confirmar Exclusão
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p class="mb-3">Tem certeza que deseja excluir a sessão <strong id="nomeSessionExclusao"></strong>?</p>
          <div class="alert alert-warning">
            <i class="ti ti-alert-triangle me-2"></i>
            <strong>Atenção:</strong> Esta ação não pode ser desfeita!
          </div>
          <input type="hidden" id="idSessionExclusao">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-danger" onclick="excluirSession()" id="btnExcluir">
            <i class="ti ti-trash me-1"></i>Excluir Sessão
          </button>
        </div>
      </div>
    </div>
  </div>

  <%- include('../scripts.ejs') %>

  <script>
    console.log('IA Manager scripts loaded');
    
    // Toggle do status da IA
    async function toggleIA(id, session) {
      console.log('toggleIA called:', id, session);
      const btn = document.getElementById(`btn-${id}`);
      const originalText = btn.innerHTML;
      
      btn.disabled = true;
      btn.innerHTML = '<i class="ti ti-loader-2 ti-spin"></i> Processando...';
      
      try {
        const response = await fetch(`/admin/ia-manager/toggle/${id}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          }
        });
        
        const data = await response.json();
        
        if (data.success) {
          // Atualizar a interface
          location.reload(); // Recarrega para mostrar mudanças
        } else {
          alert(`Erro: ${data.message}`);
          btn.innerHTML = originalText;
        }
      } catch (error) {
        console.error('Erro:', error);
        alert('Erro de conexão. Tente novamente.');
        btn.innerHTML = originalText;
      } finally {
        btn.disabled = false;
      }
    }

    // Atualizar status das sessões
    async function atualizarStatus() {
      try {
        const response = await fetch('/admin/ia-manager/status');
        const data = await response.json();
        
        if (data.success) {
          // Para simplicidade, apenas recarrega a página
          location.reload();
        }
      } catch (error) {
        console.error('Erro ao atualizar:', error);
      }
    }

    // Auto-atualizar a cada 30 segundos
    setInterval(atualizarStatus, 30000);

    // ========== CRUD FUNCTIONS ==========

    // Abrir modal nova sessão
    function abrirModalNovaSession() {
      document.getElementById('formNovaSession').reset();
      const modal = new bootstrap.Modal(document.getElementById('modalNovaSession'));
      modal.show();
    }

    // Salvar nova sessão
    async function salvarNovaSession() {
      const form = document.getElementById('formNovaSession');
      const formData = new FormData(form);
      
      // Validação básica
      const session = formData.get('session');
      const sessionkey = formData.get('sessionkey');
      
      if (!session || !sessionkey) {
        alert('Sessão e Session Key são obrigatórios!');
        return;
      }
      
      const data = {
        session: session.trim(),
        sessionkey: sessionkey.trim(),
        empresa_nome: formData.get('empresa_nome'),
        api_url: formData.get('api_url'),
        mensagem_padrao: formData.get('mensagem_padrao'),
        idprompt: formData.get('idprompt'),
        vector_name: formData.get('vector_name'),
        ia_ativa: formData.has('ia_ativa')
      };

      const btn = document.getElementById('btnSalvarNova');
      const originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="ti ti-loader-2 ti-spin me-1"></i>Salvando...';

      try {
        const response = await fetch('/admin/ia-manager/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        const result = await response.json();

        if (result.success) {
          // Fechar modal e recarregar página
          bootstrap.Modal.getInstance(document.getElementById('modalNovaSession')).hide();
          location.reload();
        } else {
          alert('Erro: ' + result.message);
        }
      } catch (error) {
        console.error('Erro ao criar sessão:', error);
        alert('Erro ao criar sessão. Tente novamente.');
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    }

    // Abrir modal editar sessão
    async function editarSession(id) {
      try {
        const response = await fetch(`/admin/ia-manager/session/${id}`);
        
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }
        
        const result = await response.json();

        if (result.success) {
          const sessao = result.data;
          
          // Preencher form
          document.getElementById('edit_id').value = sessao.id;
          document.getElementById('edit_session').value = sessao.session;
          document.getElementById('edit_sessionkey').value = sessao.sessionkey || '';
          document.getElementById('edit_empresa_nome').value = sessao.empresa_nome || '';
          document.getElementById('edit_api_url').value = sessao.api_url || '';
          document.getElementById('edit_mensagem_padrao').value = sessao.mensagem_padrao || '';
          document.getElementById('edit_idprompt').value = sessao.idprompt || '';
          document.getElementById('edit_vector_name').value = sessao.vector_name || '';
          document.getElementById('edit_ia_ativa').checked = sessao.ia_ativa;

          // Mostrar modal
          const modal = new bootstrap.Modal(document.getElementById('modalEditarSession'));
          modal.show();
        } else {
          alert('Erro ao carregar dados da sessão');
        }
      } catch (error) {
        console.error('Erro ao editar sessão:', error);
        alert('Erro ao carregar sessão para edição');
      }
    }

    // Salvar edição da sessão
    async function salvarEdicaoSession() {
      const form = document.getElementById('formEditarSession');
      const formData = new FormData(form);
      const id = formData.get('id');
      
      if (!id) {
        alert('Erro: ID da sessão não encontrado!');
        return;
      }
      
      const data = {
        session: formData.get('session'),
        sessionkey: formData.get('sessionkey'),
        empresa_nome: formData.get('empresa_nome'),
        api_url: formData.get('api_url'),
        mensagem_padrao: formData.get('mensagem_padrao'),
        idprompt: formData.get('idprompt'),
        vector_name: formData.get('vector_name'),
        ia_ativa: formData.has('ia_ativa')
      };

      const btn = document.getElementById('btnSalvarEdicao');
      const originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="ti ti-loader-2 ti-spin me-1"></i>Salvando...';

      try {
        const response = await fetch(`/admin/ia-manager/update/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        const result = await response.json();

        if (result.success) {
          // Fechar modal e recarregar página
          bootstrap.Modal.getInstance(document.getElementById('modalEditarSession')).hide();
          location.reload();
        } else {
          alert('Erro: ' + result.message);
        }
      } catch (error) {
        console.error('Erro ao atualizar sessão:', error);
        alert('Erro ao atualizar sessão. Tente novamente.');
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    }

    // Confirmar exclusão
    function confirmarExclusao(id, session) {
      document.getElementById('idSessionExclusao').value = id;
      document.getElementById('nomeSessionExclusao').textContent = session;
      
      const modal = new bootstrap.Modal(document.getElementById('modalConfirmarExclusao'));
      modal.show();
    }

    // Excluir sessão
    async function excluirSession() {
      const id = document.getElementById('idSessionExclusao').value;

      if (!id) {
        alert('Erro: ID da sessão não encontrado!');
        return;
      }

      const btn = document.getElementById('btnExcluir');
      const originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="ti ti-loader-2 ti-spin me-1"></i>Excluindo...';

      try {
        const response = await fetch(`/admin/ia-manager/delete/${id}`, {
          method: 'DELETE'
        });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        const result = await response.json();

        if (result.success) {
          // Fechar modal e recarregar página
          bootstrap.Modal.getInstance(document.getElementById('modalConfirmarExclusao')).hide();
          location.reload();
        } else {
          alert('Erro: ' + result.message);
        }
      } catch (error) {
        console.error('Erro ao excluir sessão:', error);
        alert('Erro ao excluir sessão. Tente novamente.');
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    }
  </script>

</body>
</html>
