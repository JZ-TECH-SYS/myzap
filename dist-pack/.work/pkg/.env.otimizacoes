# ⚙️ VARIÁVEIS DE AMBIENTE - OTIMIZAÇÕES

# Adicione estas variáveis ao seu arquivo .env para configurar os jobs de limpeza

# ============================================
# LIMPEZA DE CACHE
# ============================================
# Quantos dias de cache manter no banco
CACHE_RETENTION_DAYS=7

# ============================================
# LIMPEZA DE HISTÓRICO DE CHAT
# ============================================
# Quantos dias de histórico de mensagens manter
CHAT_HISTORY_RETENTION_DAYS=30

# ============================================
# LIMPEZA DE LOGS
# ============================================
# Quantos dias de logs manter
LOG_RETENTION_DAYS=7

# ============================================
# MONITORAMENTO DE MEMÓRIA
# ============================================
# Intervalo em minutos para reportar uso de memória
MEMORY_MONITOR_INTERVAL_MINUTES=15

# ============================================
# CHROME/PUPPETEER (já configurado automaticamente)
# ============================================
# As otimizações de memória do Chrome já estão aplicadas nos arquivos:
# - engines/helper/wweb.js
# - engines/helper/stealth.js
# - engines/helper/vn.js
